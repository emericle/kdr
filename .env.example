# KDR Environment Configuration
# Copy this file to .env and fill in your actual credentials

# Adanos API Configuration
# Get your API key from https://adanos.ai/
ADANOS_API_KEY=your_adanos_api_key_here

# Alpaca API Configuration
# Get your API keys from https://alpaca.markets/
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
# Optional: Base URL for development/testing (leave empty for production)
# ALPACA_BASE_URL=https://api.alpaca.markets

# PostgreSQL Database Configuration
# Format: postgresql://username:password@host:port/database_name
# If using Docker: postgresql://postgres:password@localhost:5432/kdr_db
# If using local PostgreSQL: postgresql://postgres:password@localhost:5432/postgres
DATABASE_URL=postgresql://username:password@localhost:5432/kdr_db

# Required for environment variable validation
# This can be any non-empty string for local development
# Set to your actual Adanos API key for production use
ADANOS_API_KEY=your_adanos_api_key_here