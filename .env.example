# KDR Environment Configuration
# Copy this file to .env and fill in your actual credentials

# Adanos API Configuration
# Get your API key from https://adanos.ai/
# Also required by config_gatekeeper's environment validation.
ADANOS_API_KEY=your_adanos_api_key_here

# Alpaca API Configuration
# Get your API keys from https://alpaca.markets/
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
# Optional: Base URL for development/testing (leave empty for production)
# ALPACA_BASE_URL=https://api.alpaca.markets

# PostgreSQL Database Configuration
# Format: postgresql://username:password@host:port/database_name
# If using Docker: postgresql://postgres:password@localhost:5432/kdr_db
# If using local PostgreSQL: postgresql://postgres:password@localhost:5432/postgres
DATABASE_URL=postgresql://username:password@localhost:5432/kdr_db

# Optional: separate PostgreSQL database for tests and QA runs.
# Tests use it only when they opt in (USE_QA_DB=1 / SKIP_DB_TEST=1); when it is
# unset, database-dependent tests skip instead of touching an unconfigured target.
# QA_DATABASE_URL=postgresql://username:password@localhost:5432/qa_instance

# Optional: state vector layout the model trains and decides on.
# normalized (default): log price change, sentiment on [-1, 1], position flag,
#   cash as a fraction of portfolio value.
# legacy: raw price, raw holding, raw sentiment, raw cash -- the layout the
#   pre-normalization model used, kept so a run under either flag can be compared.
# KDR_STATE_VECTOR_SCHEMA=normalized

# Optional: only read by `python -m src.backtest` (the backtesting harness).
# BACKTEST_SYMBOLS is required for that command; the others have defaults.
# BACKTEST_SYMBOLS=AAPL,TSLA
# BACKTEST_CASH=100000
# BACKTEST_MINUTES=1440